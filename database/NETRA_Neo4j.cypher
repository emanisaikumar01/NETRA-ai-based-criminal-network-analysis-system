MATCH (n) RETURN labels(n) AS label, count(n) AS count ORDER BY label;
MATCH ()-[r]->() RETURN type(r) AS relationship, count(r) AS count ORDER BY relationship;
MATCH (p:Person)-[:USES]->(ph:Phone) RETURN p.person_id, p.name, ph.phone_id, ph.phone_number ORDER BY p.person_id;
MATCH (p:Person)-[:OWNS]->(v:Vehicle) RETURN p.person_id, p.name, v.vehicle_id, v.registration_no ORDER BY p.person_id;
MATCH (p:Person)-[:OWNS]->(a:Account) RETURN p.person_id, p.name, a.account_id, a.account_type ORDER BY p.person_id;
MATCH (c:Case)-[:OCCURRED_AT]->(l:Location) RETURN c.case_id, c.crime_type, c.case_date, c.status, l.location_name, l.city ORDER BY c.case_id;
MATCH (s:Person)-[:MADE]->(t:Transaction)-[:TRANSFERRED_TO]->(r:Person) RETURN t.transaction_id, s.person_id AS sender, r.person_id AS receiver, t.amount, t.transaction_date ORDER BY t.transaction_id;
MATCH (e:Evidence)-[:SUPPORTS]->(c:Case) RETURN e.evidence_id, e.evidence_type, e.status, c.case_id ORDER BY e.evidence_id;

MATCH (p:Person)-[:MADE]->(t:Transaction)-[:TRANSFERRED_TO]->(r:Person) WHERE t.amount >= 200000 RETURN p.name AS sender, r.name AS receiver, t.amount, t.transaction_date ORDER BY t.amount DESC;
MATCH (c:Case)-[:OCCURRED_AT]->(l:Location)<-[:OCCURRED_AT]-(other:Case) WHERE c.case_id < other.case_id RETURN c.case_id, other.case_id, l.location_name;
MATCH (p:Person)-[:MADE]->(t:Transaction)-[:TRANSFERRED_TO]->(r:Person) RETURN p.person_id, p.name, count(t) AS sent_transactions ORDER BY sent_transactions DESC;
MATCH (e:Evidence)-[:SUPPORTS]->(c:Case) RETURN c.case_id, c.crime_type, count(e) AS evidence_count ORDER BY evidence_count DESC;
