MERGE (e:Evidence {evidence_id:'E001'}) SET e.evidence_type='CCTV', e.description='Vehicle observed near location', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E001'}), (c:Case {case_id:'C1042'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E002'}) SET e.evidence_type='Witness', e.description='Witness reported meeting between two persons', e.status='Reported';
MATCH (e:Evidence {evidence_id:'E002'}), (c:Case {case_id:'C1042'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E003'}) SET e.evidence_type='Financial', e.description='Transaction associated with person network', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E003'}), (c:Case {case_id:'C1042'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E004'}) SET e.evidence_type='Cash Event', e.description='Reported cash exchange with no digital record', e.status='Unverified';
MATCH (e:Evidence {evidence_id:'E004'}), (c:Case {case_id:'C1042'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E005'}) SET e.evidence_type='CCTV', e.description='Vehicle observed near incident location', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E005'}), (c:Case {case_id:'C1205'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E006'}) SET e.evidence_type='Witness', e.description='Witness reported suspicious meeting', e.status='Reported';
MATCH (e:Evidence {evidence_id:'E006'}), (c:Case {case_id:'C1210'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E007'}) SET e.evidence_type='Financial', e.description='Transaction linked to investigation network', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E007'}), (c:Case {case_id:'C1215'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E008'}) SET e.evidence_type='CCTV', e.description='Vehicle appeared near location', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E008'}), (c:Case {case_id:'C1220'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E009'}) SET e.evidence_type='Witness', e.description='Person reported suspicious activity', e.status='Reported';
MATCH (e:Evidence {evidence_id:'E009'}), (c:Case {case_id:'C1225'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E010'}) SET e.evidence_type='Financial', e.description='Unusual transaction identified', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E010'}), (c:Case {case_id:'C1230'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E011'}) SET e.evidence_type='Phone', e.description='Phone activity associated with investigation', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E011'}), (c:Case {case_id:'C1205'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E012'}) SET e.evidence_type='Vehicle', e.description='Vehicle associated with person of interest', e.status='Reported';
MATCH (e:Evidence {evidence_id:'E012'}), (c:Case {case_id:'C1210'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E013'}) SET e.evidence_type='Document', e.description='Financial document submitted for review', e.status='Verified';
MATCH (e:Evidence {evidence_id:'E013'}), (c:Case {case_id:'C1215'}) MERGE (e)-[:SUPPORTS]->(c);
MERGE (e:Evidence {evidence_id:'E014'}) SET e.evidence_type='Digital', e.description='Digital record requires further verification', e.status='Unverified';
MATCH (e:Evidence {evidence_id:'E014'}), (c:Case {case_id:'C1230'}) MERGE (e)-[:SUPPORTS]->(c);

MATCH (c:Case {case_id:'C1042'}), (l:Location {location_id:'L001'}) MERGE (c)-[:OCCURRED_AT]->(l);
